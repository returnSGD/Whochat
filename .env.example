# 复制为 .env 后按需修改。所有项都有默认值，不配也能跑。
#    cp .env.example .env

# ============================================================ 代理
#
# ⚠️ 两组代理用途完全不同，不要混用（方案文档 §2.3）：
#    download —— GitHub / HuggingFace / pip / Ollama 拉模型用
#    crawl    —— 采集用。**建议留空（直连）**
#
# 为什么采集不要走代理：平台风控对机房/代理 IP 特征识别很准，挂代理反而
# 更容易触发 403 和滑块；而且节点出口地域跳变会与账号登录态冲突。
# 浏览器自动化的核心优势是"像真人"，挂代理等于自己抹掉这个优势。

WHOCHAT_DOWNLOAD_PROXY=http://127.0.0.1:7897
WHOCHAT_CRAWL_PROXY=

# ---- HuggingFace 模型下载（实测结论，和网上常见建议相反）----
#
# ❌ 不要用 hf-mirror.com —— 实测 huggingface_hub 走镜像会持续报
#    LocalEntryNotFoundError（curl 能通，但 hub 客户端不行），
#    四个嵌入模型候选全部失败。
# ✅ 用「HF 官方 + 代理」反而稳定可用：
#
#    set HTTPS_PROXY=http://127.0.0.1:7897      (PowerShell: $env:HTTPS_PROXY="...")
#    unset HF_ENDPOINT                           (不要设成镜像)
#
# 本项目不发请求时不会自动设置代理，需要下载模型时请在运行命令前手动导出上面两个变量。
# HF_ENDPOINT=https://hf-mirror.com   # ← 实测不可用，留作参考不要启用

# Windows 下 HF 缓存默认用符号链接会告警，设这个关掉噪声
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ============================================================ 采集
#
# 限速是硬要求。低于 3 秒会显著提高被封概率。
WHOCHAT_CRAWL_INTERVAL=4.0
WHOCHAT_CRAWL_MAX_ITEMS=500
WHOCHAT_CRAWL_SUB_COMMENTS=true
WHOCHAT_CRAWL_RETRIES=3

# MediaCrawler 用的 Python 解释器。它依赖多，建议单独建环境后在这里指定；
# 留空则用当前解释器。
# WHOCHAT_MC_PYTHON=C:\path\to\mediacrawler\venv\Scripts\python.exe

# ============================================================ 存储
WHOCHAT_DB_URL=sqlite:///data/db/Whochat.db
# 迁 PostgreSQL 只需改这一行（DDL 本来就是按 PG 写的）：
# WHOCHAT_DB_URL=postgresql+psycopg://user:pass@localhost:5432/Whochat
WHOCHAT_DB_ECHO=false

# ============================================================ 本地模型清洗（可选）
#
# 开启前先确保 Ollama 已启动且模型已拉取：
#   ollama pull qwen2.5:14b-instruct-q4_K_M
#
# 选 Qwen 的理由：14B 的 JSON 可靠性评为 Excellent（专为结构化输出训练），
# 7B 只是 Good，更小的模型在复杂 schema 下经常出非法语法。
WHOCHAT_LLM_ENABLED=false
WHOCHAT_LLM_BASE_URL=http://127.0.0.1:11434
WHOCHAT_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M
WHOCHAT_LLM_TIMEOUT=120

# ============================================================ 情感分析
#
# lexicon     —— 词典法，零依赖，毫秒级，可复现。自建标注集上 90.9%
# transformer —— 需要 torch + 权重下载
#
# ⚠️ 实测结论（33 条标注集，2026-09-12）：
#    IDEA-CCNL/Erlangshen-Roberta-110M-Sentiment 是**二分类**模型（正/负），
#    没有"中性"这一档，而本链路是完整三分类。实测只有 60.6%，反而远低于词典法。
#    原因：中性样本的分数铺满 [-1,1] 且与正面样本（+0.93~+1.0）完全重叠，
#    **不存在能分开的中性带**，调 neutral_band 也救不回来
#    （拉宽会把正确的正面一起吞掉）。
#    要走模型路线请换**三分类**中文情感模型，或用业务数据微调（方案文档 §4.1）。
#    在拿到三分类模型之前，保持 lexicon。
WHOCHAT_SENTIMENT_BACKEND=lexicon
WHOCHAT_SENTIMENT_MODEL=IDEA-CCNL/Erlangshen-Roberta-110M-Sentiment
WHOCHAT_SENTIMENT_DEVICE=cpu
# 分数绝对值低于此值算中性。调大 → 更多中性；调小 → 更极化的分布
# 注意：这个参数对二分类模型基本无效（见上面的实测结论）
WHOCHAT_SENTIMENT_NEUTRAL_BAND=0.15

# ============================================================ 预警推送
#
# 企业微信群机器人 Webhook。留空则进入 dry-run 模式（只打印不发送），
# 本地调试时建议先留空。
#   群设置 → 群机器人 → 添加 → 复制 Webhook 地址
WHOCHAT_WECOM_WEBHOOK=

# 同一事件冷却秒数。没有冷却会导致爆发时同一条规则每分钟刷屏
WHOCHAT_ALERT_COOLDOWN=300
# 聚合窗口：窗口内的告警合并成一条推送
WHOCHAT_ALERT_AGG_WINDOW=600

# ⚠️ 企微硬限制是 20 条/分钟/机器人，且实测第 6~8 条就可能丢。
#    这里默认压到 15 留安全余量 —— 因为同一个机器人可能被多个模块共享配额。
WHOCHAT_ALERT_MAX_PER_MINUTE=15

# ============================================================ 其他
WHOCHAT_DATA_DIR=
WHOCHAT_DICT_DIR=
# 中文字体路径。不指定则自动探测（Windows 下一般是微软雅黑）
# WHOCHAT_CJK_FONT=C:\Windows\Fonts\msyh.ttc
